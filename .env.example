# URL de conexión directa a PostgreSQL en Supabase
# Ejemplo: postgresql://[usuario]:[contraseña]@[host]:[puerto]/[base_de_datos]
DATABASE_URL=postgresql://postgres:su-contrasena@supabase.acanoa.es:5432/postgres

# Configuración de importación programada diaria
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_HOUR=03:00
AUTO_IMPORT_TIMEZONE=Europe/Madrid
