# Sólo servidor. Usar la conexión PostgreSQL central configurada en el host.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/postgres
APP_ENV=development
CORS_ORIGINS=http://localhost:8080
ADMIN_API_TOKEN=cambie-esta-clave-en-produccion
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# Tareas programadas del backend.
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_HOUR=03:00
AUTO_IMPORT_TIMEZONE=Europe/Madrid
IMPORT_STALE_MINUTES=30
DOWNLOAD_DIR=/app/descargas

# Sólo frontend: ruta pública, nunca contiene secretos.
VITE_API_BASE_URL=/apps/loteria-consulta/api
